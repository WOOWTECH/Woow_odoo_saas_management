<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                    woow.service  Kanban                      -->
    <!-- ============================================================ -->
    <record id="woow_service_view_kanban" model="ir.ui.view">
        <field name="name">woow.service.kanban</field>
        <field name="model">woow.service</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" highlight_color="color">
                <field name="id"/>
                <field name="name"/>
                <field name="logo"/>
                <field name="icon"/>
                <field name="color"/>
                <field name="url"/>
                <field name="category_ids"/>
                <field name="internal_manager_id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <!-- Aside: logo / icon / initial -->
                        <aside class="o_kanban_aside_full">
                            <t t-if="record.logo.raw_value">
                                <field name="logo" widget="image" options="{'size': [90, 90]}" class="rounded"/>
                            </t>
                            <t t-elif="record.icon.value">
                                <span class="o_kanban_image_fill_left d-flex align-items-center justify-content-center rounded bg-100"
                                      style="width:90px;height:90px;font-size:2.5rem;">
                                    <i t-attf-class="fa #{record.icon.value}"/>
                                </span>
                            </t>
                            <t t-else="">
                                <span class="o_kanban_image_fill_left d-flex align-items-center justify-content-center rounded text-white fw-bold"
                                      style="width:90px;height:90px;font-size:2.5rem;background-color:#00897B;">
                                    <t t-esc="(record.name.value || '?')[0].toUpperCase()"/>
                                </span>
                            </t>
                        </aside>
                        <!-- Main content -->
                        <main>
                            <div class="mb-1">
                                <strong class="o_kanban_record_title fs-5">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="mb-1">
                                <field name="category_ids" widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                            </div>
                            <div class="text-muted small mb-2" t-if="record.internal_manager_id.value">
                                <i class="fa fa-user-o me-1" title="Internal Manager"/>
                                <field name="internal_manager_id"/>
                            </div>
                            <div>
                                <button name="action_open_service" type="object"
                                        class="btn btn-primary btn-sm">
                                    <i class="fa fa-external-link me-1"/>Open Service
                                </button>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                    woow.service  Form                        -->
    <!-- ============================================================ -->
    <record id="woow_service_view_form" model="ir.ui.view">
        <field name="name">woow.service.form</field>
        <field name="model">woow.service</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_service" type="object"
                            string="Open Service" class="oe_highlight"
                            icon="fa-external-link"/>
                </header>
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"
                           options="{'size': [90, 90]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Service Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="url" widget="url" placeholder="e.g. slack.com"/>
                            <field name="full_url" widget="url"/>
                            <field name="icon" placeholder="e.g. fa-rocket"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="category_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <field name="internal_manager_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General" name="general">
                            <field name="description" placeholder="Public description of this service…"/>
                        </page>
                        <page string="Sharing" name="sharing">
                            <group>
                                <field name="share_partner_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                    woow.service  List                        -->
    <!-- ============================================================ -->
    <record id="woow_service_view_list" model="ir.ui.view">
        <field name="name">woow.service.list</field>
        <field name="model">woow.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="url" widget="url"/>
                <field name="internal_manager_id"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                    woow.service  Search                      -->
    <!-- ============================================================ -->
    <record id="woow_service_view_search" model="ir.ui.view">
        <field name="name">woow.service.search</field>
        <field name="model">woow.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_ids"/>
                <field name="internal_manager_id"/>
                <field name="url"/>
                <separator/>
                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category_ids'}"/>
                    <filter name="group_manager" string="Internal Manager"
                            context="{'group_by': 'internal_manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                    woow.service  Action                      -->
    <!-- ============================================================ -->
    <record id="woow_service_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">woow.service</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="woow_service_view_search"/>
    </record>

</odoo>
