<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                  woow.service.category List                  -->
    <!-- ============================================================ -->
    <record id="woow_service_category_view_list" model="ir.ui.view">
        <field name="name">woow.service.category.list</field>
        <field name="model">woow.service.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                  woow.service.category Form                  -->
    <!-- ============================================================ -->
    <record id="woow_service_category_view_form" model="ir.ui.view">
        <field name="name">woow.service.category.form</field>
        <field name="model">woow.service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--                  woow.service.category Action                -->
    <!-- ============================================================ -->
    <record id="woow_service_category_action" model="ir.actions.act_window">
        <field name="name">Service Categories</field>
        <field name="res_model">woow.service.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
